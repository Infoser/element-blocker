{
  "manifest_version": 3,
  "name": "P-Locker - Element Blocker",
  "version": "1.0.0",
  "description": "Click to block page elements - make them transparent and click-through",
  "permissions": ["activeTab", "storage", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "P-Locker - Element Blocker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}